                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "x1TlW",
                      "name": "pbQTxt",
                      "fill": "#1C1C19",
                      "content": "La tipografía es la voz silenciosa del texto. Cada elección de letra dice algo antes de que se lea una sola palabra.",
                      "fontFamily": "Newsreader",
                      "fontSize": 17,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "text",
                      "id": "AKkeI",
                      "name": "pbQAttr",
                      "fill": "#999999",
                      "content": "— Robert Bringhurst",
                      "fontFamily": "Newsreader",
                      "fontSize": 12,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
